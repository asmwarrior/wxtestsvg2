<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="wxtestsvg2" />
		<Option execution_dir="./" />
		<Option pch_mode="2" />
		<Option default_target="win_gcc" />
		<Option compiler="null" />
		<Build>
			<Target title="win_gcc">
				<Option output="bin/$(TARGET_NAME)/$(PROJECT_NAME)" prefix_auto="1" extension_auto="1" />
				<Option object_output=".objs/$(TARGET_NAME)" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="`$(#WX_CONFIG) --cflags`" />
					<Add directory="liblunasvg/include/lunasvg" />
				</Compiler>
				<ResourceCompiler>
					<Add option="`$(#WX_CONFIG) --rcflags`" />
				</ResourceCompiler>
				<Linker>
					<Add option="`$(#WX_CONFIG) --libs base,core`" />
					<Add library="liblunasvg/bin/liblunasvg.dll" />
					<Add directory="liblunasvg/bin" />
				</Linker>
			</Target>
			<Target title="win_bcc">
				<Option output="bin/$(TARGET_NAME)/$(PROJECT_NAME)" prefix_auto="1" extension_auto="1" />
				<Option object_output=".objs/$(TARGET_NAME)" />
				<Option type="0" />
				<Option compiler="bcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="`$(#WX_CONFIG) --cflags`" />
				</Compiler>
				<Linker>
					<Add option="`$(#WX_CONFIG) --libs base,core`" />
				</Linker>
				<ExtraCommands>
					<Add before="cmd /c echo $(WXWIN)\lib\$(WXCFG)" />
				</ExtraCommands>
				<Environment>
					<Variable name="WX_CONFIG" value="wx-config --compiler=bcc  --wxcfg=$(WXCFG)" />
				</Environment>
			</Target>
			<Target title="win_vc">
				<Option output="bin/$(TARGET_NAME)/$(PROJECT_NAME)" prefix_auto="1" extension_auto="1" />
				<Option object_output=".objs/$(TARGET_NAME)" />
				<Option type="0" />
				<Option compiler="msvc10" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="`$(#WX_CONFIG) --cflags`" />
				</Compiler>
				<Linker>
					<Add option="`$(#WX_CONFIG) --libs base,core`" />
				</Linker>
				<ExtraCommands>
					<Add before="cmd /c echo $(WXWIN)\lib\$(WXCFG)" />
				</ExtraCommands>
				<Environment>
					<Variable name="WX_CONFIG" value="wx-config --compiler=vc  --wxcfg=$(WXCFG)" />
				</Environment>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="win_gcc;win_bcc;win_vc;" />
		</VirtualTargets>
		<ResourceCompiler>
			<Add directory="%WXWIN%/include" />
		</ResourceCompiler>
		<Unit filename="bmpbndl_lunasvg.cpp">
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="bmpbndl_lunasvg.h">
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="sample.rc">
			<Option compilerVar="WINDRES" />
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="svgapp.cpp">
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="svgbench.cpp">
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="svgbench.h">
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="svgframe.cpp">
			<Option target="win_gcc" />
		</Unit>
		<Unit filename="svgframe.h">
			<Option target="win_gcc" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
